---
import site from '../data/site.json';
// src/components/Footer.astro

// Detectar idioma actual
const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const langPrefix = isEnglish ? '/en' : '/es';

// Textos por idioma
const footerTexts = {
  navegacion: isEnglish ? 'Navigation' : 'Navegación',
  inicio: isEnglish ? 'Home' : 'Inicio',
  productos: isEnglish ? 'Products' : 'Productos',
  nosotros: isEnglish ? 'About' : 'Nosotros',
  contacto: isEnglish ? 'Contact' : 'Contacto',
  contactoTitle: isEnglish ? 'Contact' : 'Contacto',
  privacidad: isEnglish ? 'Privacy Policy' : 'Política de Privacidad',
  terminos: isEnglish ? 'Terms of Service' : 'Términos de Servicio',
  derechos: isEnglish ? 'All rights reserved.' : 'Todos los derechos reservados.',
  horario: isEnglish ? 'Mon-Fri: 08:00 - 17:00' : 'Lun-Vie: 08:00 - 17:00',
};
---

<footer class="w-full bg-gray-900 text-white py-16 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      
      {/* Sobre */}
      <div>
        <h3 class="text-2xl font-bold text-bergner-red mb-4">BERGNER</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          {isEnglish 
            ? 'High performance industrial solutions. Valve manufacturing, components and compressor maintenance with over 30 years of experience.' 
            : 'Soluciones industriales de alto rendimiento. Fabricación de válvulas, componentes y mantenimiento de compresores con más de 30 años de experiencia.'}
        </p>
      </div>

      {/* Links */}
      <div>
        <h4 class="font-bold mb-6 text-white">{footerTexts.navegacion}</h4>
        <ul class="space-y-3 text-sm">
          <li><a href={`${langPrefix}/`} class="text-gray-400 hover:text-bergner-red transition-colors">{footerTexts.inicio}</a></li>
          <li><a href={`${langPrefix}/productos`} class="text-gray-400 hover:text-bergner-red transition-colors">{footerTexts.productos}</a></li>
          <li><a href={`${langPrefix}/nosotros`} class="text-gray-400 hover:text-bergner-red transition-colors">{footerTexts.nosotros}</a></li>
          <li><a href={`${langPrefix}/contacto`} class="text-gray-400 hover:text-bergner-red transition-colors">{footerTexts.contacto}</a></li>
        </ul>
      </div>

      {/* Contacto */}
      <div>
        <h4 class="font-bold mb-6 text-white">{footerTexts.contactoTitle}</h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li>📍 Buenos Aires, Argentina</li>
          <li>📞 11 5810-3726</li>
          <li>📧 info@bergner.com.ar</li>
          <li>🕒 {footerTexts.horario}</li>
        </ul>
      </div>

      {/* Social */}
      <div>
        <h4 class="font-bold mb-6 text-white">Síguenos</h4>
        <div class="flex gap-4">
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 hover:bg-bergner-red rounded-full flex items-center justify-center transition-colors" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-9h3v9zm-1.5-10.268c-.966 0-1.75-.796-1.75-1.774s.784-1.774 1.75-1.774 1.75.796 1.75 1.774-.784 1.774-1.75 1.774zm13.5 10.268h-3v-4.5c0-1.072-.021-2.453-1.494-2.453-1.496 0-1.725 1.168-1.725 2.379v4.574h-3v-9h2.881v1.233h.041c.401-.76 1.379-1.561 2.839-1.561 3.037 0 3.6 2.001 3.6 4.601v4.727z" />
            </svg>
          </a>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-gray-800 hover:bg-bergner-red rounded-full flex items-center justify-center transition-colors" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.338 3.608 1.313.975.975 1.251 2.242 1.313 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.338 2.633-1.313 3.608-.975.975-2.242 1.251-3.608 1.313-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.338-3.608-1.313-.975-.975-1.251-2.242-1.313-3.608-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.062-1.366.338-2.633 1.313-3.608.975-.975 2.242-1.251 3.608-1.313 1.266-.058 1.646-.07 4.85-.07zm0-2.163c-3.259 0-3.667.012-4.947.071-1.529.070-2.577.33-3.49.704a5.92 5.92 0 00-2.137 1.39 5.92 5.92 0 00-1.39 2.137c-.374.913-.634 1.961-.704 3.49-.059 1.28-.071 1.688-.071 4.947s.012 3.667.071 4.947c.070 1.529.33 2.577.704 3.49.331.807.794 1.53 1.39 2.137.607.596 1.33 1.059 2.137 1.39.913.374 1.961.634 3.49.704 1.28.059 1.688.071 4.947.071s3.667-.012 4.947-.071c1.529-.070 2.577-.33 3.49-.704a5.92 5.92 0 002.137-1.39 5.92 5.92 0 001.39-2.137c.374-.913.634-1.961.704-3.49.059-1.28.071-1.688.071-4.947s-.012-3.667-.071-4.947c-.070-1.529-.33-2.577-.704-3.49a5.92 5.92 0 00-1.39-2.137 5.92 5.92 0 00-2.137-1.39c-.913-.374-1.961-.634-3.49-.704-1.28-.059-1.688-.071-4.947-.071z" />
              <path d="M12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a3.999 3.999 0 110-7.998 3.999 3.999 0 010 7.998z" />
              <circle cx="18.406" cy="5.594" r="1.44" />
            </svg>
          </a>
        </div>
      </div>

    </div>

    <div class="border-t border-gray-800 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center text-gray-400 text-sm">
        <p>&copy; 2026 Bergner Argentina. {footerTexts.derechos}</p>
        <div class="flex gap-6 mt-4 md:mt-0">
          <a href="#" class="hover:text-bergner-red transition-colors">{footerTexts.privacidad}</a>
          <a href="#" class="hover:text-bergner-red transition-colors">{footerTexts.terminos}</a>
        </div>
      </div>
    </div>

  </div>
</footer>
