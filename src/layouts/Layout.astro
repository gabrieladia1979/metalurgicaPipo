---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
import '../styles/global.css';
import site from '../data/site.json';

// Detect current language from URL
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : 'es';

// URL base del sitio — funciona en Vercel, bergner.com.ar, etc.
const siteOrigin = Astro.url.origin;
const ogImageUrl = `${siteOrigin}/android-chrome-512x512.png`;
const canonicalUrl = `${siteOrigin}${currentPath}`;

const defaultDesc = "Fabricación de repuestos para compresores alternativos. Más de 50 años de experiencia. Contacto y cotizaciones.";
const metaDesc = description || defaultDesc;
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDesc} />
    <meta name="keywords" content="repuestos para compresores, compresores a pistón, válvulas para compresores, industria PET, compresión de gas, metalúrgica industrial, mecanizado de piezas especiales" />

    <!-- Open Graph / WhatsApp / Redes Sociales -->
    <meta property="og:title" content={`${title} | Metalúrgica Bergner S.A.`} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Metalúrgica Bergner S.A." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | Metalúrgica Bergner S.A.`} />
    <meta name="twitter:description" content={metaDesc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Seguridad -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title} | Bergner S.A.</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- JSON-LD: Google Logo en resultados de búsqueda -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Metalúrgica Bergner S.A.",
      "url": siteOrigin,
      "logo": ogImageUrl,
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+54-351-461-3939",
        "contactType": "customer service",
        "availableLanguage": "Spanish"
      }
    })} />

    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  </head>
  <body class="bg-white flex flex-col min-h-screen">
    <slot />
    
    <!-- Botón flotante WhatsApp -->
    <div class="fixed bottom-6 right-6 z-50 flex items-center gap-3 group">
      <span class="bg-white text-gray-800 px-3 py-2 rounded-lg shadow-lg font-medium text-xs transition-all duration-300 opacity-100 group-hover:translate-x-[-6px] hidden sm:block relative after:content-[''] after:absolute after:top-1/2 after:right-[-6px] after:-translate-y-1/2 after:border-t-8 after:border-t-transparent after:border-l-8 after:border-l-white after:border-b-8 after:border-b-transparent">
        WhatsApp
      </span>

      <div class="relative flex items-center justify-center">
        <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 animate-ping"></span>
        <a
          href={`https://wa.me/${site.whatsappNumber}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactar por WhatsApp"
          class="relative bg-[#25D366] hover:bg-[#20bd5a] text-white w-16 h-16 rounded-full shadow-xl transition-all duration-300 hover:scale-110 flex items-center justify-center"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.52 3.48A11.78 11.78 0 0 0 12 0C5.37 0 .02 5.35 0 11.94c0 2.1.55 4.15 1.6 5.97L0 24l6.27-1.64a11.94 11.94 0 0 0 5.72 1.46h.01c6.6 0 11.98-5.35 11.99-11.94a11.87 11.87 0 0 0-3.47-8.4zM12 21.5h-.01a9.52 9.52 0 0 1-4.86-1.33l-.35-.2-3.72.97.99-3.63-.23-.37A9.56 9.56 0 0 1 2.5 11.95C2.5 6.84 6.92 2.5 12.03 2.5A9.37 9.37 0 0 1 21.5 12c-.01 5.11-4.42 9.5-9.5 9.5zm5.17-7.13c-.28-.14-1.64-.81-1.9-.9-.25-.09-.43-.14-.61.14-.18.28-.7.9-.86 1.09-.16.18-.32.2-.6.07-.28-.14-1.17-.43-2.23-1.37-.82-.73-1.37-1.63-1.53-1.9-.16-.28-.02-.43.12-.57.13-.13.28-.32.42-.48.14-.16.19-.28.28-.46.09-.18.04-.34-.02-.48-.06-.14-.61-1.46-.84-2-.22-.53-.45-.45-.61-.46-.16-.01-.34-.01-.52-.01-.18 0-.47.07-.72.35-.25.28-.95.96-.95 2.34 0 1.38.98 2.72 1.11 2.9.14.19 1.92 2.93 4.65 4.11.65.28 1.16.45 1.55.57.65.21 1.25.18 1.71.11.52-.08 1.62-.66 1.85-1.3.23-.65.23-1.2.16-1.3-.06-.12-.25-.19-.53-.33z"/>
          </svg>
        </a>
      </div>
    </div>
  </body>
</html>
