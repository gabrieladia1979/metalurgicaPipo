---
// src/pages/en/contacto.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import site from '../../data/site.json';
---

<Layout title="Contact">
  <Header />
  
  <main class="min-h-screen bg-white">
    {/* Hero */}
    <section class="bg-gradient-to-b from-gray-50 to-white py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Contact
        </h1>
        <p class="text-lg text-gray-600 max-w-2xl">
          We're here to help. Get in touch with us in the way that works best for you.
        </p>
      </div>
    </section>

    {/* Content - Redesigned without form */}
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
            
            {/* Address */}
            <div class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow group">
               <div class="w-16 h-16 bg-bergner-red/10 group-hover:bg-bergner-red/20 rounded-full flex items-center justify-center mb-6 text-bergner-red transition-colors">
                  <span class="text-3xl">📍</span>
               </div>
               <h3 class="font-bold text-gray-900 mb-2 text-xl">Address</h3>
               <p class="text-gray-600 leading-relaxed">
                 {site.address}
               </p>
            </div>

            {/* Phone */}
            <div class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow group">
               <div class="w-16 h-16 bg-bergner-red/10 group-hover:bg-bergner-red/20 rounded-full flex items-center justify-center mb-6 text-bergner-red transition-colors">
                  <span class="text-3xl">📞</span>
               </div>
               <h3 class="font-bold text-gray-900 mb-2 text-xl">Phone</h3>
               <p class="text-gray-600 font-medium text-lg mb-1">{site.phone}</p>
               <p class="text-gray-500 text-sm">Monday to Friday<br/>08:00 - 17:00.</p>
            </div>

            {/* Email */}
            <div class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow group">
               <div class="w-16 h-16 bg-bergner-red/10 group-hover:bg-bergner-red/20 rounded-full flex items-center justify-center mb-6 text-bergner-red transition-colors">
                  <span class="text-3xl">📧</span>
               </div>
               <h3 class="font-bold text-gray-900 mb-2 text-xl">Email</h3>
               <a href={`mailto:${site.email}`} class="text-bergner-red hover:text-red-700 font-medium text-lg break-all transition-colors cursor-pointer">
                 {site.email}
               </a>
               <p class="text-gray-500 text-sm mt-1">Inquiries and Quotes.</p>
            </div>

            {/* WhatsApp */}
            <div class="bg-gray-50 rounded-2xl p-8 flex flex-col items-center text-center shadow-sm hover:shadow-md transition-shadow group">
               <div class="w-16 h-16 bg-green-600/10 group-hover:bg-green-600/20 rounded-full flex items-center justify-center mb-6 text-green-600 transition-colors">
                  <span class="text-3xl">💬</span>
               </div>
               <h3 class="font-bold text-gray-900 mb-2 text-xl">WhatsApp</h3>
               <p class="text-gray-600 mb-4">{site.phone}</p>
               <a 
                 href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent('Hello, I want to inquire...')}`}
                 target="_blank"
                 rel="noopener noreferrer"
                 class="inline-block bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-full font-bold transition-colors shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
               >
                 Send Message
               </a>
            </div>

        </div>

        {/* Social Networks */}
        <div class="text-center border-t border-gray-100 pt-16">
          <h3 class="font-bold text-gray-900 mb-8 text-2xl">Follow Us</h3>
          <div class="flex gap-6 justify-center">
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="w-14 h-14 bg-gray-100 hover:bg-bergner-red hover:text-white rounded-full flex items-center justify-center transition-all text-2xl duration-300" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-9h3v9zm-1.5-10.268c-.966 0-1.75-.796-1.75-1.774s.784-1.774 1.75-1.774 1.75.796 1.75 1.774-.784 1.774-1.75 1.774zm13.5 10.268h-3v-4.5c0-1.072-.021-2.453-1.494-2.453-1.496 0-1.725 1.168-1.725 2.379v4.574h-3v-9h2.881v1.233h.041c.401-.76 1.379-1.561 2.839-1.561 3.037 0 3.6 2.001 3.6 4.601v4.727z"/></svg>
          </a>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="w-14 h-14 bg-gray-100 hover:bg-bergner-red hover:text-white rounded-full flex items-center justify-center transition-all text-2xl duration-300" aria-label="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.366.062 2.633.338 3.608 1.313.975.975 1.251 2.242 1.313 3.608.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.062 1.366-.338 2.633-1.313 3.608-.975.975-2.242 1.251-3.608 1.313-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.366-.062-2.633-.338-3.608-1.313-.975-.975-1.251-2.242-1.313-3.608-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.062-1.366.338-2.633 1.313-3.608.975-.975 2.242-1.251 3.608-1.313 1.266-.058 1.646-.07 4.85-.07zm0-2.163c-3.259 0-3.667.012-4.947.071-1.529.070-2.577.33-3.49.704a5.92 5.92 0 00-2.137 1.39 5.92 5.92 0 00-1.39 2.137c-.374.913-.634 1.961-.704 3.49-.059 1.28-.071 1.688-.071 4.947s.012 3.667.071 4.947c.070 1.529.33 2.577.704 3.49.331.807.794 1.53 1.39 2.137.607.596 1.33 1.059 2.137 1.39.913.374 1.961.634 3.49.704 1.28.059 1.688.071 4.947.071s3.667-.012 4.947-.071c1.529-.070 2.577-.33 3.49-.704a5.92 5.92 0 002.137-1.39 5.92 5.92 0 001.39-2.137c.374-.913.634-1.961.704-3.49.059-1.28.071-1.688.071-4.947s-.012-3.667-.071-4.947c-.070-1.529-.33-2.577-.704-3.49a5.92 5.92 0 00-1.39-2.137 5.92 5.92 0 00-2.137-1.39c-.913-.374-1.961-.634-3.49-.704-1.28-.059-1.688-.071-4.947-.071z" />
            <path d="M12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a3.999 3.999 0 110-7.998 3.999 3.999 0 010 7.998z" />
            <circle cx="18.406" cy="5.594" r="1.44" />
            </svg>
          </a>
          </div>
        </div>

      </div>
    </section>

    {/* Map */}
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Location</h2>
        <div class="rounded-xl overflow-hidden shadow-lg h-96 bg-gray-200">
          <iframe
            src="https://www.google.com/maps/embed?pb=!4v1768578270776!6m8!1m7!1spjoI7bLf-dz8a3KwkGXExA!2m2!1d-34.54203012634142!2d-58.51985884123237!3f259!4f0!5f0.7820865974627469"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full"
            title="Location map"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- Downloads: Company Summaries -->
    <section class="py-12 bg-white border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Company Summaries</h2>
        <p class="text-gray-600 mb-6">Download the institutional profiles in PDF.</p>

        <div class="grid md:grid-cols-2 gap-6">
          <a href="/pdf/PRESENTACION%20BERGNER%201%20ESP..pdf" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between p-4 border rounded hover:shadow-sm">
            <div>
              <p class="font-semibold text-gray-900">Bergner Presentation – ESP</p>
              <p class="text-sm text-gray-500">Commercial overview and product lines.</p>
            </div>
            <div class="text-sm text-bergner-red font-medium">Download</div>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
