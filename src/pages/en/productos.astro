---
// src/pages/en/productos.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import site from '../../data/site.json';

const whatsappNumber = site.whatsappNumber || '5491100000000';

const products = [
  {
    id: 1,
    title: 'Piston Rings',
    subtitle: 'Compression and Guide Rings',
    description: 'We manufacture compression and guide rings for reciprocating compressor pistons. Available in cast iron, bronze, and loaded PTFE depending on the application. They ensure efficient sealing, reduce wear, and extend the compressor\'s service life. Manufactured to customer drawings or samples.',
    image: '/docs/producto 1.jpg',
    tags: ['Cast Iron', 'Bronze', 'PTFE'],
  },
  {
    id: 2,
    title: 'Compressor Valves',
    subtitle: 'Intake, Exhaust and Concentric',
    description: 'We design and manufacture high-efficiency intake, exhaust, and concentric valves for gas and air compressors. Built in stainless steel and special alloys, they ensure reliable operation at high and low pressure. We replicate valves from any brand or model.',
    image: '/docs/producto 2.jpg',
    tags: ['Stainless Steel', 'High Pressure', 'Low Pressure'],
  },
  {
    id: 3,
    title: 'Unloader Piston',
    subtitle: 'Regulation and Load Control',
    description: 'The unloader piston is a key component in compressor regulation systems. We manufacture custom unloader pistons tailored to each equipment\'s requirements, ensuring precise and efficient load control.',
    image: '/docs/producto 3.jpeg',
    tags: ['Load Control', 'Regulation', 'Custom Made'],
  },
  {
    id: 4,
    title: 'Gaskets',
    subtitle: 'Static Sealing for Covers, Cylinders and Crankcases',
    description: 'We produce flat and special gaskets for static sealing on cylinder heads, compressor bodies, and crankcases. Available in graphite, copper, aluminum, Klinger, and other materials. Manufactured to drawings or samples, for any brand and model of compressor.',
    image: '/docs/producto 4.jpeg',
    tags: ['Graphite', 'Copper', 'Aluminum', 'Klinger'],
  },
  {
    id: 5,
    title: 'Rod Seals',
    subtitle: 'Packings and Dynamic Sealing',
    description: 'We manufacture packing rings and dynamic seals for reciprocating compressor rods. These include oil scrapers and pressure packings of tangential and radial type, in materials such as Babbitt, bronze, and PTFE/graphite, adapted to the operating conditions of each unit.',
    image: '/docs/producto 5.jpeg',
    tags: ['Babbitt', 'Bronze', 'PTFE/Graphite', 'Tangential/Radial'],
  },
  {
    id: 6,
    title: 'Internal Spare Parts',
    subtitle: 'Bearings, Bushings, Bolts and More',
    description: 'We supply a wide range of internal spare parts for reciprocating compressors: bearings, bushings, special bolts, pins, washers, and other critical components. We work from customer drawings or take measurements directly from original parts to ensure an exact replacement.',
    image: '/docs/producto 6.jpeg',
    tags: ['Bearings', 'Bushings', 'Bolts', 'Various Components'],
  },
];
---

<Layout title="Products | Spare Parts for Reciprocating Compressors" description="Valves, rings, packings, gaskets and spare parts for reciprocating compressors. Over 50 years of manufacturing experience.">
  <Header />

  <main class="min-h-screen bg-white">

    {/* Section Hero */}
    <div class="bg-gray-950 text-white py-20 px-4 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[url('/docs/valvulas.jpg')] bg-cover bg-center"></div>
      <div class="relative max-w-4xl mx-auto text-center">
        <span class="inline-block bg-bergner-red text-white text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6">Our Products</span>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Spare Parts for<br class="hidden md:block" /> Reciprocating Compressors
        </h1>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto leading-relaxed">
          We manufacture spare parts to drawings or samples for any brand and model of compressor.
          Over 50 years of experience guarantee quality and precision in every part.
        </p>
      </div>
    </div>

    {/* Products List */}
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto space-y-0">
        {products.map((product, index) => (
          <div
            class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} items-center gap-0 border-b border-gray-100 last:border-0`}
          >
            {/* Image */}
            <div class="w-full md:w-1/2 overflow-hidden bg-gray-50">
              <div class="relative h-80 md:h-96 overflow-hidden group">
                <img
                  src={product.image}
                  alt={product.title}
                  class="w-full h-full object-contain p-8 transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-950/10 to-transparent"></div>
              </div>
            </div>

            {/* Content */}
            <div class={`w-full md:w-1/2 py-12 ${index % 2 === 0 ? 'md:pl-16 md:pr-8' : 'md:pr-16 md:pl-8'}`}>
              <div class="w-10 h-0.5 bg-bergner-red mb-5"></div>
              <h2 class="text-3xl font-bold text-gray-900 mb-1">{product.title}</h2>
              <p class="text-bergner-red font-semibold text-sm uppercase tracking-wide mb-5">{product.subtitle}</p>
              <p class="text-gray-600 leading-relaxed mb-7 text-base">
                {product.description}
              </p>

              {/* Tags */}
              <div class="flex flex-wrap gap-2 mb-8">
                {product.tags.map(tag => (
                  <span class="bg-gray-100 text-gray-700 text-xs font-medium px-3 py-1.5 rounded-full border border-gray-200">
                    {tag}
                  </span>
                ))}
              </div>

              {/* CTA */}
              <a
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hello, I'd like to inquire about: ${product.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 bg-gray-950 hover:bg-bergner-red text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200 group"
              >
                <svg class="w-5 h-5 text-green-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
                </svg>
                Inquire about this product
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Final CTA */}
    <section class="bg-bergner-red text-white py-16 mt-4">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Need a spare part not listed here?</h2>
        <p class="text-lg mb-8 opacity-90">
          We manufacture custom parts to drawings or samples. Contact us for expert advice.
        </p>
        <a
          href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hello, I have a question about Bergner products...')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-white text-bergner-red hover:bg-gray-100 px-10 py-4 rounded-lg font-bold text-lg transition-colors"
        >
          Contact via WhatsApp
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>