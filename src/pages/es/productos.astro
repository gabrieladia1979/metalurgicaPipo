---
// src/pages/es/productos.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import site from '../../data/site.json';

const whatsappNumber = site.whatsappNumber || '5491100000000';

const productos = [
  {
    id: 1,
    title: 'Aros de Pistón',
    subtitle: 'Compresión y Guía',
    description: 'Fabricamos aros de compresión y guía para pistones de compresores a pistón. Disponibles en hierro fundido, bronce y PTFE con carga según la aplicación. Garantizan un sellado eficiente, reducen el desgaste y prolongan la vida útil del compresor. Se fabrican bajo plano o muestra del cliente.',
    image: '/docs/producto 1.jpg',
    tags: ['Hierro Fundido', 'Bronce', 'PTFE'],
  },
  {
    id: 2,
    title: 'Válvulas de Compresor',
    subtitle: 'Admisión, Escape y Concéntricas',
    description: 'Diseñamos y fabricamos válvulas de admisión, escape y concéntricas de alta eficiencia para compresores de gas y aire. Construidas en acero inoxidable y aleaciones especiales, aseguran un funcionamiento confiable a alta y baja presión. Reemplazamos válvulas de cualquier marca o modelo.',
    image: '/docs/producto 2.jpg',
    tags: ['Acero Inoxidable', 'Alta Presión', 'Baja Presión'],
  },
  {
    id: 3,
    title: 'Pistón Descargador',
    subtitle: 'Regulación y Control de Carga',
    description: 'El pistón descargador es un componente clave en los sistemas de regulación de compresores. Fabricamos pistones descargadores a medida, adaptados a los requerimientos de cada equipo, garantizando un control de carga preciso y eficiente.',
    image: '/docs/producto 3.jpeg',
    tags: ['Control de Carga', 'Regulación', 'A Medida'],
  },
  {
    id: 4,
    title: 'Juntas',
    subtitle: 'Sellado Estático para Tapas, Cilindros y Cárter',
    description: 'Producimos juntas planas y especiales para sellado estático en tapas de cilindros, cuerpo de compresor y cárter. Disponibles en grafito, cobre, aluminio, Klinger y otros materiales. Se fabrican bajo plano o muestra, para cualquier marca y modelo de compresor.',
    image: '/docs/producto 4.jpeg',
    tags: ['Grafito', 'Cobre', 'Aluminio', 'Klinger'],
  },
  {
    id: 5,
    title: 'Sellos de Vástago',
    subtitle: 'Empaquetaduras y Sellado Dinámico',
    description: 'Fabricamos empaquetaduras y sellos dinámicos para vástagos de compresores a pistón. Incluyen rascadores de aceite y empaquetaduras de presión de tipo tangencial y radial, en materiales como Babbitt, bronce y PTFE/grafito, adaptados a las condiciones operativas de cada equipo.',
    image: '/docs/producto 5.jpeg',
    tags: ['Babbitt', 'Bronce', 'PTFE/Grafito', 'Tangencial/Radial'],
  },
  {
    id: 6,
    title: 'Repuestos Internos',
    subtitle: 'Cojinetes, Bujes, Pernos y Más',
    description: 'Suministramos una amplia gama de repuestos internos para compresores a pistón: cojinetes, bujes, pernos especiales, pasadores, arandelas y otros componentes críticos. Trabajamos con los planos del cliente o tomamos medidas directamente de las piezas originales para garantizar una reposición exacta.',
    image: '/docs/producto 6.jpeg',
    tags: ['Cojinetes', 'Bujes', 'Pernos', 'Componentes Varios'],
  },
];
---

<Layout title="Productos | Repuestos para Compresores a Pistón" description="Válvulas, aros, empaquetaduras, juntas y repuestos para compresores a pistón. Fabricación nacional con más de 50 años de experiencia.">
  <Header />

  <main class="min-h-screen bg-white">

    {/* Hero de la sección */}
    <div class="bg-gray-950 text-white py-20 px-4 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[url('/docs/valvulas.jpg')] bg-cover bg-center"></div>
      <div class="relative max-w-4xl mx-auto text-center">
        <span class="inline-block bg-bergner-red text-white text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6">Nuestros Productos</span>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Repuestos para Compresores<br class="hidden md:block" /> a Pistón
        </h1>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto leading-relaxed">
          Fabricamos repuestos bajo plano o muestra para cualquier marca y modelo de compresor. 
          Más de 50 años de experiencia garantizan calidad y precisión en cada pieza.
        </p>
      </div>
    </div>

    {/* Lista de Productos */}
    <section class="py-20 px-4">
      <div class="max-w-6xl mx-auto space-y-0">
        {productos.map((producto, index) => (
          <div
            class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} items-center gap-0 border-b border-gray-100 last:border-0`}
          >
            {/* Imagen */}
            <div class="w-full md:w-1/2 overflow-hidden bg-gray-50">
              <div class="relative h-80 md:h-96 overflow-hidden group">
                <img
                  src={producto.image}
                  alt={producto.title}
                  class="w-full h-full object-contain p-8 transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-gray-950/10 to-transparent"></div>
              </div>
            </div>

            {/* Contenido */}
            <div class={`w-full md:w-1/2 py-12 ${index % 2 === 0 ? 'md:pl-16 md:pr-8' : 'md:pr-16 md:pl-8'}`}>
              <div class="w-10 h-0.5 bg-bergner-red mb-5"></div>
              <h2 class="text-3xl font-bold text-gray-900 mb-1">{producto.title}</h2>
              <p class="text-bergner-red font-semibold text-sm uppercase tracking-wide mb-5">{producto.subtitle}</p>
              <p class="text-gray-600 leading-relaxed mb-7 text-base">
                {producto.description}
              </p>

              {/* Tags */}
              <div class="flex flex-wrap gap-2 mb-8">
                {producto.tags.map(tag => (
                  <span class="bg-gray-100 text-gray-700 text-xs font-medium px-3 py-1.5 rounded-full border border-gray-200">
                    {tag}
                  </span>
                ))}
              </div>

              {/* CTA */}
              <a
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hola, me interesa consultar sobre: ${producto.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 bg-gray-950 hover:bg-bergner-red text-white font-semibold px-6 py-3 rounded-lg transition-colors duration-200 group"
              >
                <svg class="w-5 h-5 text-green-400 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.9 1.225l-.35-.177-3.632.363.369-3.431-.211-.338a9.9 9.9 0 011.527-5.645C6.45.931 10.437-.046 14.122 1.261c3.686 1.307 6.348 4.708 6.348 8.653 0 2.373-.72 4.619-2.086 6.52l-.26.39 3.04.364-.368 3.471-.394-.221a9.875 9.875 0 01-6.302 2.216h-.003c-5.487 0-9.979-4.492-9.979-9.979 0-2.633 1.024-5.115 2.886-7.041z"/>
                </svg>
                Consultar por este producto
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* CTA Final */}
    <section class="bg-bergner-red text-white py-16 mt-4">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Necesita un repuesto que no aparece aquí?</h2>
        <p class="text-lg mb-8 opacity-90">
          Fabricamos piezas a medida bajo plano o muestra. Contáctenos y le asesoramos.
        </p>
        <a
          href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola, tengo una consulta sobre productos Bergner...')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-white text-bergner-red hover:bg-gray-100 px-10 py-4 rounded-lg font-bold text-lg transition-colors"
        >
          Contactar por WhatsApp
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
