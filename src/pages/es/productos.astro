---
// src/pages/es/productos.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import site from '../../data/site.json';

const whatsappNumber = site.whatsappNumber || '5491100000000';

const productos = [
  {
    id: 1,
    title: 'Válvulas de Compresor',
    subtitle: 'Admisión, Escape y Concéntricas',
    description: 'Diseñamos y fabricamos válvulas de admisión, escape y concéntricas de alta eficiencia para compresores de gas y aire. Están construidas en acero inoxidable y aleaciones especiales, garantizando un funcionamiento confiable tanto en condiciones de alta como de baja presión. Las válvulas incorporan tratamientos superficiales que incrementan la resistencia al desgaste, reducen la fricción y contribuyen a prolongar la vida útil de los componentes.',
    image: '/fotos_productos/foto1.jpeg',
    objectPosition: 'center center',
    tags: ['Aceros inoxidables y aleados', 'Alta Presión', 'Baja Presión', 'Tratamiento Superficial'],
  },
  {
    id: 2,
    title: 'Sellos de Vástago',
    subtitle: 'Empaquetaduras y Sellos',
    description: 'Fabricamos empaquetaduras y sistemas de sellado para vástagos de compresores alternativos. Incluyen rascadores y empaquetaduras de tipo tangencial y radial, diseñadas para asegurar la correcta estanqueidad y el funcionamiento confiable del sistema bajo presión. Se fabrican en materiales como Babbitt, bronce y compuestos de PTFE/grafito, seleccionados según las condiciones de presión, temperatura y régimen operativo de cada equipo.',
    image: '/fotos_productos/sellos.jpeg',
    objectPosition: 'center 30%',
    tags: ['Babbitt', 'Bronce', 'PTFE/Grafito', 'Tangencial/Radial'],
  },
  {
    id: 3,
    title: 'Aros de Pistón',
    subtitle: 'Guía y Compresión',
    description: 'Los compresores alternativos utilizan dos tipos principales de aros: guía y compresión. El aro guía mantiene el pistón correctamente alineado dentro del cilindro, asegurando un desplazamiento estable y rectilíneo. Los aros de compresión garantizan la estanqueidad de la cámara durante la carrera del pistón. Dependiendo de la presión de trabajo, los compresores pueden operar en dos, tres o más etapas de compresión, reduciendo progresivamente el volumen de gas para una compresión eficiente.',
    image: '/fotos_productos/aros.jpeg',
    objectPosition: 'center center',
    tags: ['PTFE c/ especiales', 'Alineación', 'Estanqueidad'],
  },
  {
    id: 4,
    title: 'Pistón Descargador de Bronce',
    subtitle: 'Control de Carga por Accionamiento Neumático',
    description: 'Componente diseñado para la apertura mecánica de válvulas de admisión en compresores de gas y aire. Transmite el movimiento generado por un cilindro neumático de simple efecto, permitiendo modular la capacidad operativa del compresor. Su geometría optimizada en bronce antifricción garantiza un accionamiento dinámico y suave, con alta durabilidad ante frecuencias de ciclado elevadas y ajuste preciso para el conjunto Pistón–Abreválvula–Válvula.',
    image: '/fotos_productos/valvulas.jpeg',
    objectPosition: 'center 20%',
    tags: ['Bronce Antifricción', 'Accionamiento Neumático', 'Alta Durabilidad', 'A Medida'],
  },
];
---

<Layout title="Productos | Repuestos para Compresores a Pistón" description="Válvulas, aros, empaquetaduras, juntas y repuestos para compresores a pistón. Fabricación nacional con más de 50 años de experiencia.">
  <Header />

  <main class="min-h-screen bg-white">

    {/* Hero de la sección */}
    <div class="bg-gray-950 text-white py-20 px-4 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[url('/docs/valvulas.jpg')] bg-cover bg-center"></div>
      <div class="relative max-w-4xl mx-auto text-center">
        <span class="inline-block bg-bergner-red text-white text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6">Nuestros Productos</span>
        <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
          Repuestos para Compresores<br class="hidden md:block" /> a Pistón
        </h1>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto leading-relaxed">
          Fabricamos repuestos bajo plano o muestra para cualquier marca y modelo de compresor. 
          Más de 50 años de experiencia garantizan calidad y precisión en cada pieza.
        </p>
      </div>
    </div>

    {/* Lista de Productos */}
    <section class="py-16 px-4">
      <div class="max-w-6xl mx-auto">
        {productos.map((producto, index) => (
          <div
            class={`flex flex-col ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} items-stretch gap-8 md:gap-0 border-b border-gray-100 last:border-0 py-12 md:py-16`}
          >
            {/* Imagen */}
            <div class="w-full md:w-1/2 relative min-h-[320px] md:min-h-[500px] overflow-hidden">
              <div class="absolute inset-0 w-full h-full overflow-hidden group">
                <img
                  src={producto.image}
                  alt={producto.title}
                  style={`object-position: ${producto.objectPosition}`}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
                <div class="absolute bottom-4 left-5">
                  <span class="text-white/60 text-xs font-bold tracking-widest uppercase">{String(producto.id).padStart(2,'0')}</span>
                </div>
              </div>
            </div>

            {/* Contenido */}
            <div class={`w-full md:w-1/2 ${index % 2 === 0 ? 'md:pl-16 md:pr-10' : 'md:pr-16 md:pl-10'} flex flex-col justify-center`}>
              <div class="w-10 h-0.5 bg-bergner-red mb-5"></div>
              <h2 class="text-3xl font-bold text-gray-900 mb-2 leading-tight">{producto.title}</h2>
              <p class="text-bergner-red font-semibold text-sm uppercase tracking-widest mb-6">{producto.subtitle}</p>
              <p class="text-gray-600 leading-relaxed mb-8 text-base">
                {producto.description}
              </p>

              {/* Tags */}
              <div class="flex flex-wrap gap-2 mb-8">
                {producto.tags.map(tag => (
                  <span class="bg-gray-50 text-gray-600 text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-200 hover:border-bergner-red hover:text-bergner-red transition-colors">
                    {tag}
                  </span>
                ))}
              </div>

              {/* CTA */}
              <a
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hola, me interesa consultar sobre: ${producto.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 bg-bergner-red hover:bg-red-700 text-white font-semibold px-7 py-3.5 rounded-lg transition-all duration-200 group shadow-md hover:shadow-lg self-start"
              >
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                Consultar por este producto
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* CTA Final */}
    <section class="bg-bergner-red text-white py-16 mt-4">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Necesita un repuesto que no aparece aquí?</h2>
        <p class="text-lg mb-8 opacity-90">
          Fabricamos piezas a medida bajo plano o muestra. Contáctenos y le asesoramos.
        </p>
        <a
          href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Hola, tengo una consulta sobre productos Bergner...')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block bg-white text-bergner-red hover:bg-gray-100 px-10 py-4 rounded-lg font-bold text-lg transition-colors"
        >
          Contactar por WhatsApp
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
